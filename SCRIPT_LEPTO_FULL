anos <- 2007:2025
dados_por_ano <- list()

for(ano in anos) {
  nome_objeto <- paste0("lepto_", ano)
  
  if(exists(nome_objeto)) {
    dados_por_ano[[as.character(ano)]] <- get(nome_objeto)
  }
}

