  }
}

# ============================================
# 4. VARIÁVEIS COMUNS ENTRE TODOS OS ANOS
# ============================================

variaveis_por_ano <- lapply(dados_por_ano, names)

variaveis_comuns <- Reduce(intersect, variaveis_por_ano)

cat("\n\n=== VARIÁVEIS COMUNS A TODOS OS ANOS ===\n")
cat("Total:", length(variaveis_comuns), "variáveis\n")
cat("Lista:", paste(variaveis_comuns, collapse = ", "))

# ============================================
# 5. VARIÁVEIS QUE APARECEM APENAS EM ALGUNS ANOS
# ============================================

todas_variaveis <- unique(unlist(variaveis_por_ano))

variaveis_inconsistentes <- todas_variaveis[!todas_variaveis %in% variaveis_comuns]

cat("\n\n=== VARIÁVEIS QUE NÃO ESTÃO EM TODOS OS ANOS ===\n")
cat("Total:", length(variaveis_inconsistentes), "variáveis\n")

for(var in head(variaveis_inconsistentes, 30)) {
  anos_presentes <- names(which(sapply(variaveis_por_ano, function(x) var %in% x)))
