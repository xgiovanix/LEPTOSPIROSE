# FLOWCHART OF SAMPLE SELECTION FOR HOSPITALIZED ADULT PATIENTS WITH CONFIRMED LEPTOSPIROSIS
# Database: SINAN Leptospirosis, Brazil, 2007–2025
# Inclusion criteria:
#   1. Total records
#   2. Hospital admission
#   3. Confirmed leptospirosis
#   4. Age ≥ 18 years
#   5. Known outcome
# FONTE de DADOS: http://portalsinan.saude.gov.br/leptospirose
#
# Ficha de notificação/investigação
# Instrucional de preenchimento da ficha de notificação/investigação
# Dicionário de Dados
#
# Author: Giovani B Costa
# Date: 18/04/2026
# ==========================================================================================

library(ggplot2)
library(dplyr)

# ====================================
# Criar colunas de idade 
# ====================================

leptospirose <- lepto2007_2025 %>%
  mutate(
    primeiro_digito = substr(as.character(NU_IDADE_N), 1, 1),
    valor_idade = as.numeric(
      substr(as.character(NU_IDADE_N), 2, nchar(as.character(NU_IDADE_N)))
    ),
    IDADE_ANOS = ifelse(primeiro_digito == "4", valor_idade, NA)
  )

hist(leptospirose$IDADE_ANOS)

# ====================================
# Etapa 1: Total de registros
# ====================================

n1 <- nrow(leptospirose)
# ====================================
# Etapa 2: Hospital admission (ATE_HOSP == 1)
# ====================================
n2 <- leptospirose %>%
  filter(ATE_HOSP == 1) %>%
  nrow()
# ====================================
# Etapa 3: Hospital admission with confirmed leptospirosis
# ====================================
n3 <- leptospirose %>%
  filter(ATE_HOSP == 1) %>%
  filter(CLASSI_FIN == 1) %>%
  nrow()
# ====================================
# Etapa 4: Excluir pacientes com idade < 18 anos
# ====================================
n4 <- leptospirose %>%
  filter(ATE_HOSP == 1) %>%
  filter(CLASSI_FIN == 1) %>%
  filter(primeiro_digito == "4") %>%
  filter(valor_idade >= 18) %>%
  nrow()
# ====================================
# Etapa 5: Excluir pacientes sem desfecho disponível
# ====================================
n5 <- leptospirose %>%
  filter(ATE_HOSP == 1) %>%
  filter(CLASSI_FIN == 1) %>%
  filter(primeiro_digito == "4") %>%
  filter(valor_idade >= 18) %>%
  filter(EVOLUCAO %in% c(1, 2)) %>%
  nrow()
# ====================================
# Número de excluídos em cada etapa
# ====================================
exc1 <- n1 - n2
exc2 <- n2 - n3
exc3 <- n3 - n4
exc4 <- n4 - n5
# ====================================
# Resumo
# ====================================
cat("\n========== FLOWCHART ==========\n\n")
cat("Total records:", n1, "\n")
cat("Hospital admission:", n2, " | Excluded:", exc1, "\n")
cat("Hospital admission with confirmed leptospirosis:", n3, " | Excluded:", exc2, "\n")
cat("Age ≥ 18 years:", n4, " | Excluded:", exc3, "\n")
cat("Known outcome:", n5, " | Excluded:", exc4, "\n")
cat("\nFinal included:", n5, "\n")

