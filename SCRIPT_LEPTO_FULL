# ============================================

cat("\n\n=== COMPARAÇÃO ENTRE ANOS SELECIONADOS ===\n")

anos_para_comparar <- c("2007", "2010", "2020", "2025")

for(ano in anos_para_comparar) {
  if(ano %in% names(dados_por_ano)) {
    cat("\n--- Ano", ano, "---\n")
    cat("Total de variáveis:", ncol(dados_por_ano[[ano]]), "\n")
